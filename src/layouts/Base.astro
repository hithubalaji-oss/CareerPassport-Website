---
/**
 * Shared document shell.
 *
 * The Google Fonts request is a top-level <link>, not an @import inside the token sheet:
 * nested there the browser cannot begin it until that file has been parsed, and the CSSOM
 * cannot read a cross-origin imported sheet at all. The 8 Sep design moved to Poppins for
 * display and Inter for body, keeping Geist Mono for code and eyebrows.
 *
 * Tokens arrive as one bundled sheet. The eight token files plus styles.css were nine
 * render-blocking requests, and styles.css was an @import list — so the tokens were not
 * even requested until it had been fetched and parsed.
 */
import '../styles/ds/tokens.bundle.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      crossorigin="anonymous"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&family=Inter:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
    />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
