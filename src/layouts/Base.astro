---
/**
 * Shared document shell.
 *
 * The Google Fonts request is a top-level <link>, not an @import inside the token sheet:
 * nested there the browser cannot begin it until that file has been parsed, and the CSSOM
 * cannot read a cross-origin imported sheet at all. The 8 Sep design moved to Poppins for
 * display and Inter for body, keeping Geist Mono for code and eyebrows.
 *
 * Tokens arrive as one bundled sheet. The eight token files plus styles.css were nine
 * render-blocking requests, and styles.css was an @import list — so the tokens were not
 * even requested until it had been fetched and parsed.
 */
import { execSync } from 'node:child_process';
import '../styles/ds/tokens.bundle.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

/* The build id, stamped on <html> at build time — no script, no runtime cost, every page.
   It exists because "is this phone actually looking at the new build?" cost this project two
   round trips and most of a day: a stale production alias is indistinguishable from a fix that
   did not work, and there is no way to tell them apart by looking at the page.
   Vercel sets VERCEL_GIT_COMMIT_SHA; locally we ask git; if neither answers the build still
   succeeds with a placeholder rather than failing over a label. */
const BUILD_ID = (() => {
  const sha = process.env.VERCEL_GIT_COMMIT_SHA;
  if (sha) return sha.slice(0, 7);
  try {
    return execSync('git rev-parse --short HEAD', { stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim();
  } catch {
    return 'local';
  }
})();
---

<!doctype html>
<html lang="en" data-build={BUILD_ID}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      crossorigin="anonymous"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&family=Inter:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
    />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
