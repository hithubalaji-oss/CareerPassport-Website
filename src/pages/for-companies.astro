---
/**
 * For Companies — hiring managers and talent teams.
 *
 * Opens on a pinned hero where the brief is written, then the pinned process stage.
 * Everything else is an ordinary block in the document flow — a deliberate correction, as
 * an earlier build pinned every fold and headings slid under the header.
 */
import Base from '../layouts/Base.astro';
import Header from '../components/chrome/Header.astro';
import Footer from '../components/chrome/Footer.astro';
import Ground from '../components/companies/Ground.astro';
import Hero from '../components/companies/Hero.astro';
import ProcessDemo from '../components/companies/ProcessDemo.astro';
import Comparison from '../components/companies/Comparison.astro';
import Closing from '../components/companies/Closing.astro';

import '../styles/cp-header.css';
import '../styles/companies.css';
---

<Base
  title="CareerPassport — For Companies"
  description="Tell us who you need. CareerPassport builds the hiring journey, runs it, and brings you the evidence — so you meet fewer people and know more about the ones you do."
>
  <Ground />
  <Header />
  <Hero />
  <ProcessDemo />
  <Comparison />
  <Closing />
  <Footer cta="Hire on evidence" />

  <script src="/image-slot.js" is:inline></script>
  <script src="../scripts/companies.js"></script>
  <script src="../scripts/cp-keys.js"></script>
</Base>
