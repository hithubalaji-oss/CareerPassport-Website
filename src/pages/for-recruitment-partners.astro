---
/**
 * For Recruitment Partners — agencies and headhunters.
 *
 * Rebuilt in the 8 Sep pass. The six pinned folds over one persistent network panel are
 * gone; the page is now hero, slab, the long story section, a stacked band and a quote
 * slab — ordinary blocks, matching the direction For Companies moved to. It still loads
 * cp-shared.css and cp-page.js for the shared fold engine and reveal behaviour.
 */
import Base from '../layouts/Base.astro';
import Header from '../components/chrome/Header.astro';
import Footer from '../components/chrome/Footer.astro';
import Ground from '../components/partners/Ground.astro';
import Main from '../components/partners/Main.astro';
import Outro from '../components/partners/Outro.astro';

// cp-shared.css before the page sheet, then cp-header.css, matching the prototype's order.
import '../styles/cp-shared.css';
import '../styles/partners.css';
import '../styles/cp-header.css';
import '../styles/mobile-pages.css';
---

<Base
  title="CareerPassport — For Recruitment Partners"
  description="More leverage from the network you already own. Build your recruitment business in the AI era — your candidates, your relationships, your business."
>
  <Ground />
  <Header />
  <Main />
  <Outro />
  <Footer cta="Grow your recruitment business" />

  <script src="/image-slot.js" is:inline></script>
  <script src="../scripts/cp-page.js"></script>
  <script src="../scripts/partners.js"></script>
</Base>
