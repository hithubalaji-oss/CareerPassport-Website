---
/**
 * Homepage — candidate-facing, and the most motion-heavy page in the set.
 *
 * Five tall folds plus a closing act, with one passport object persisting across all of
 * them. All motion runs from a single requestAnimationFrame loop in homepage.js: one
 * frame() that reads every fold's getBoundingClientRect in a batch and THEN writes. That
 * split is load-bearing — interleaving reads and writes causes layout thrash every frame.
 */
import Base from '../layouts/Base.astro';
import Header from '../components/chrome/Header.astro';
import Footer from '../components/chrome/Footer.astro';
import Ground from '../components/homepage/Ground.astro';
import Passport from '../components/homepage/Passport.astro';
import Folds from '../components/homepage/Folds.astro';
import Outro from '../components/homepage/Outro.astro';
import VideoOverlay from '../components/homepage/VideoOverlay.astro';

import '../styles/cp-header.css';
import '../styles/homepage.css';
/* Additive, and last, so its mobile rules win at equal specificity. Nothing in it applies
   above 1024px — the desktop driver is untouched. See the file header for why it is separate
   from homepage.css rather than inside it. */
import '../styles/mobile-passport.css';
---

<Base
  title="CareerPassport — The professional identity for ambitious people"
  description="Your work, your projects, your skills — turned into a record employers can actually trust. One that keeps growing with you."
>
  <Fragment slot="head">
    {/* Both are injected by script, so the browser cannot see them in the markup.
        Preloading gets the fetches started during parse.

        The crowd plate ships in two sizes and homepage.js picks between them on the same
        1025px boundary. The preload has to agree with that choice or the browser fetches
        one plate here and the driver fetches the other — so both carry the matching media
        query, and a phone downloads 0.23 MB instead of 0.23 + 0.92. */}
    <link rel="preload" as="image" href="/uploads/Crowd-6ce23065-1280.webp" media="(max-width: 1024px)" />
    <link rel="preload" as="image" href="/uploads/Crowd-6ce23065.webp" media="(min-width: 1025px)" />
    <link rel="preload" as="video" href="/assets/hero-lift.mp4" type="video/mp4" />
    {/* MUST be is:inline and MUST be in the head. Astro bundles and reorders <script src>
        tags, and it put mobile-passport.js AFTER the driver — so the driver started, wrote
        inline styles onto .bookwrap and .zone, and those outranked the mobile stylesheet.
        Setting the flag during head parsing is the only placement that is ordered before
        every body script, whatever the bundler decides to do with them. */}
    <script is:inline>
      if (window.matchMedia('(max-width: 1024px)').matches) window.__cpManual = 1;
    </script>
  </Fragment>

  <Ground />
  <Header />
  <Passport />
  <Folds />
  <Outro />
  <Footer cta="Your passport, waiting" />
  <VideoOverlay />

  {/* BEFORE homepage.js: it sets window.__cpManual while the driver is still parsing, so on
      a phone the driver never starts. Above 1024px it returns immediately and changes nothing. */}
  <script src="../scripts/mobile-passport.js"></script>
  <script src="../scripts/homepage.js"></script>
  <script src="../scripts/homepage-extra.js"></script>
  <script src="../scripts/cp-keys.js"></script>
  <script src="../scripts/video-overlay.js"></script>
</Base>
