---
/**
 * 04 - Testimonials as boarding passes. A quote coupon and a perforated stub carrying role
 * and a metric, with punched notches. Cards reveal in sequence at a .11s stagger via `--i`.
 *
 * All three quotes are placeholders - `[Placeholder]` copy and `[Name]` attributions.
 * Real quotes, names and companies drop straight in.
 */
---

<section class="sec" data-screen-label="05">
  <div class="inner">
    <div class="split rv" style="margin-bottom:clamp(26px,3.6vh,44px)">
      <div class="sh">
        <p class="eyebrow gold"><i></i>From the people hiring</p>
        <h2>What changes when <span class="serif">evidence arrives first.</span></h2>
      </div>
    </div>
    <div class="passes">
      <article class="pass rv" style="--i:0">
        <div class="pmain">
          <div class="phead"><span>TESTIMONIAL</span><em>INTENT &rarr; HIRE</em></div>
          <p class="pquote">[Placeholder] We stopped reading CVs to guess. The brief told us what to explore, so the interview started at the interesting part.</p>
          <div class="pwho"><strong>[Name]</strong><span>HEAD OF TALENT &middot; SERIES B FINTECH</span></div>
        </div>
        <div class="pstub">
          <div class="pf"><b>ROLE</b><span>SR PM</span></div>
          <div class="pf"><b>TIME TO HIRE</b><span>19 DAYS</span></div>
          <div class="bars" aria-hidden="true"><i style="height:100%"></i><i style="height:60%"></i><i style="height:90%"></i><i style="height:45%"></i><i style="height:100%"></i><i style="height:70%"></i><i style="height:85%"></i><i style="height:50%"></i><i style="height:95%"></i><i style="height:65%"></i><i style="height:80%"></i><i style="height:55%"></i></div>
        </div>
      </article>
      <article class="pass rv" style="--i:1">
        <div class="pmain">
          <div class="phead"><span>TESTIMONIAL</span><em>INTENT &rarr; HIRE</em></div>
          <p class="pquote">[Placeholder] One standard across three recruitment partners. For the first time everyone was evaluating the same things.</p>
          <div class="pwho"><strong>[Name]</strong><span>TALENT DIRECTOR &middot; ENTERPRISE SAAS</span></div>
        </div>
        <div class="pstub">
          <div class="pf"><b>ROLE</b><span>ENG LEAD</span></div>
          <div class="pf"><b>PARTNERS</b><span>03</span></div>
          <div class="bars" aria-hidden="true"><i style="height:80%"></i><i style="height:100%"></i><i style="height:55%"></i><i style="height:90%"></i><i style="height:65%"></i><i style="height:100%"></i><i style="height:48%"></i><i style="height:85%"></i><i style="height:70%"></i><i style="height:95%"></i><i style="height:60%"></i><i style="height:88%"></i></div>
        </div>
      </article>
      <article class="pass rv" style="--i:2">
        <div class="pmain">
          <div class="phead"><span>TESTIMONIAL</span><em>INTENT &rarr; HIRE</em></div>
          <p class="pquote">[Placeholder] The admin disappeared. My team spent their week on conversations instead of scheduling them.</p>
          <div class="pwho"><strong>[Name]</strong><span>VP PEOPLE &middot; MARKETPLACE</span></div>
        </div>
        <div class="pstub">
          <div class="pf"><b>ROLE</b><span>DESIGN</span></div>
          <div class="pf"><b>INTERVIEWS</b><span>&minus;42%</span></div>
          <div class="bars" aria-hidden="true"><i style="height:65%"></i><i style="height:95%"></i><i style="height:50%"></i><i style="height:100%"></i><i style="height:75%"></i><i style="height:60%"></i><i style="height:90%"></i><i style="height:55%"></i><i style="height:100%"></i><i style="height:70%"></i><i style="height:85%"></i><i style="height:48%"></i></div>
        </div>
      </article>
    </div>
  </div>
</section>
