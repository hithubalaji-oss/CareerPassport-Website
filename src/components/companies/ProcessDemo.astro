                <g class="exdotg" data-w="0"><animateMotion dur="2.8s" begin="0s" repeatCount="indefinite" keyPoints="0;1" keyTimes="0;1" calcMode="linear"><mpath href="#exw0"/></animateMotion><circle class="exdot" r="0.4"/></g>
                <g class="exdotg" data-w="1"><animateMotion dur="2.8s" begin="0.4s" repeatCount="indefinite" keyPoints="0;1" keyTimes="0;1" calcMode="linear"><mpath href="#exw1"/></animateMotion><circle class="exdot" r="0.4"/></g>
                <g class="exdotg" data-w="2"><animateMotion dur="2.8s" begin="0.8s" repeatCount="indefinite" keyPoints="0;1" keyTimes="0;1" calcMode="linear"><mpath href="#exw2"/></animateMotion><circle class="exdot" r="0.4"/></g>
                <g class="exdotg" data-w="3"><animateMotion dur="2.8s" begin="1.2s" repeatCount="indefinite" keyPoints="0;1" keyTimes="0;1" calcMode="linear"><mpath href="#exw3"/></animateMotion><circle class="exdot" r="0.4"/></g>
                <g class="exdotg" data-w="4"><animateMotion dur="2.8s" begin="1.6s" repeatCount="indefinite" keyPoints="0;1" keyTimes="0;1" calcMode="linear"><mpath href="#exw4"/></animateMotion><circle class="exdot" r="0.4"/></g>
                <g class="exdotg" data-w="5"><animateMotion dur="2.8s" begin="2s" repeatCount="indefinite" keyPoints="0;1" keyTimes="0;1" calcMode="linear"><mpath href="#exw5"/></animateMotion><circle class="exdot" r="0.4"/></g>
                <g class="exdotg" data-w="6"><animateMotion dur="2.8s" begin="2.4s" repeatCount="indefinite" keyPoints="0;1" keyTimes="0;1" calcMode="linear"><mpath href="#exw6"/></animateMotion><circle class="exdot" r="0.4"/></g>
                <path class="wire reach" pathLength="1" data-r="0" d="M88 16 C94 16 94 7 101 7"></path>
                <path class="wire reach" pathLength="1" data-r="0" d="M88 16 H101"></path>
                <path class="wire reach" pathLength="1" data-r="0" d="M88 16 C94 16 94 25 101 25"></path>
