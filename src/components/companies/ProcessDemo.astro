                  <span class="bqhandle" aria-hidden="true">⋮⋮</span>
                  <div class="bqbody">
                    <div class="bpload bqload"><i></i><i></i><i></i></div>
                    <p class="bqtext">Sales sold what engineering says it cannot build. Your first move?</p>
                    <span class="bqhint">Long answer text</span>
                  </div>
                  <span class="bqtype">Paragraph <svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"></path></svg></span>
                </div>
                <div class="bpq" data-q="1">
                  <span class="bqhandle" aria-hidden="true">⋮⋮</span>
                  <div class="bqbody">
                    <div class="bpload bqload"><i></i><i></i><i></i></div>
                    <p class="bqtext">Three bets: one working, one flat, one losing. Plan next quarter.</p>
                    <span class="bqhint"><svg viewBox="0 0 24 24" class="bqstar"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.27 5.82 22 7 14.14l-5-4.87 6.91-1.01Z"></path></svg><svg viewBox="0 0 24 24" class="bqstar"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.27 5.82 22 7 14.14l-5-4.87 6.91-1.01Z"></path></svg><svg viewBox="0 0 24 24" class="bqstar"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.27 5.82 22 7 14.14l-5-4.87 6.91-1.01Z"></path></svg><svg viewBox="0 0 24 24" class="bqstar"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.27 5.82 22 7 14.14l-5-4.87 6.91-1.01Z"></path></svg><svg viewBox="0 0 24 24" class="bqstar"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.27 5.82 22 7 14.14l-5-4.87 6.91-1.01Z"></path></svg></span>
                  </div>
                  <span class="bqtype">Rating <svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"></path></svg></span>
                </div>
                <div class="bpq" data-q="2">
                  <span class="bqhandle" aria-hidden="true">⋮⋮</span>
                  <div class="bqbody">
                    <div class="bpload bqload"><i></i><i></i><i></i></div>
                    <p class="bqtext">A key customer is about to churn mid-migration. What do you do?</p>
                    <span class="bqhint">Upload a file</span>
                  </div>
