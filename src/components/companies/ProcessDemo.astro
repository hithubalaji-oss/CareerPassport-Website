---
/**
 * 02 - The process, pinned. Five acts - DEFINE, DESIGN, EXECUTE, EVIDENCE, DECIDE -
 * advanced by scroll across a sticky stage that never moves.
 *
 * Two changes in this revision:
 *  - DESIGN is now a tabbed blueprint panel (`#bpTabs` / `#bpPanel` / `#bpQs`) with a
 *    lever control, replacing the five flat blueprint cards.
 *  - DECIDE now opens an actual passport - the same book object as the Homepage, with
 *    its cover, spine, verso and five leaves - rather than a row of interview slots.
 *
 * The step maths lives in `src/scripts/companies.js`, carried over verbatim: measure the
 * pin rather than the window, and keep the 1e-6 epsilon on the stage floor.
 * Panes in the pinned stage cannot scroll, so everything here tightens explicitly at
 * 1199px and 767px instead of overflowing.
 */
---

<!-- ============ 03 · FROM ONE SENTENCE TO A HIRING BLUEPRINT ============ -->
<section class="aidemo" id="aidemo" data-screen-label="02" aria-label="From one sentence to a hiring blueprint">
  <div class="aidemopin">
    <div class="flapglow" aria-hidden="true"></div>
    <div class="flapbg" id="flapBg" aria-hidden="true"></div>
    <div class="flapvig" aria-hidden="true"></div>
    <div class="actdots" id="actDots" aria-hidden="true">
      <i></i><i></i><i></i><i></i>
    </div>
    <div class="aiwrap">
      <div class="aivisual">
        <div class="aistage" id="aiStage">
        <div class="aibox" id="aiBox">
          <div class="aiprep" id="aiPrep">
            <span class="aidots" aria-hidden="true"><i></i><i></i><i></i></span>
            <p class="shimmer">Hiring blueprint is being prepared</p>
          </div>

          <div class="aibp" id="aiBp">
