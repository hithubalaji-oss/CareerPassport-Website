            </div>

            <!-- the record itself, the same passport the homepage turns -->
            <div class="dcpass" id="dcPass">
              <div class="dcstage">
              <div class="dcpp" id="dcPp">
                <div class="book" id="dcBook">
          <div class="pg verso" id="dcVerso"></div>
          <div class="spine" id="dcSpine"></div>
          <div class="pg recto base"></div>
          
          <div class="leaf" id="dcLeaf5" style="z-index:10"><div class="lf"><span class="pglbl">PAGE 10 / WHAT YOU ALREADY HAVE</span>
