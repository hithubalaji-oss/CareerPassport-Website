                <path class="wire reach" pathLength="1" data-r="3" d="M88 84 H101"></path>
                <path class="wire reach" pathLength="1" data-r="3" d="M88 84 C94 84 94 93 101 93"></path>
              </svg>
              <span class="exnode src" data-n="0" style="left:16%;top:24%"><b>128</b>Company database</span>
