---
/**
 * The closing act. The email capture is a front-end state change only.
 */
---

<section class="outro" id="outro">
  <div class="ocopy">
    <p class="eyebrow gold reveal"><i></i>Partner with CareerPassport</p>
    <h2 class="reveal">Modern recruitment agency looking to <em class="serif">scale their business?</em></h2>
    <p class="lede reveal">CareerPassport gives recruitment partners the technology, demand and trusted network they need to run better, fulfil faster and grow their business.</p>
    <p class="fine reveal">For recruitment agencies, solopreneurs and headhunters</p>
  </div>
  <div class="cart" aria-hidden="true">
    <div class="oring"></div>
    <div class="palmglow"></div>
    <div class="present cpres">
      <div class="pgroup">
      <div class="pscreen">
        <image-slot id="rp-close-product" shape="rect" radius="14"
          placeholder="Drop a product screen grab (16:9)"></image-slot>
        <span class="pchrome" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="plbl">PRODUCT &middot; LIVE ROLE</span>
      </div>
      <div class="pphone cpassport">
        <div class="cpface">
            <div class="cspine"></div>
            <div class="clbl">CAREERPASSPORT</div>
            <div class="crest">
              <svg class="cring" viewBox="0 0 156 156" aria-hidden="true">
                <defs><path id="cringClose" d="M78 78 m-66.875 0 a66.875 66.875 0 1 1 133.75 0 a66.875 66.875 0 1 1 -133.75 0"/></defs>
                <text><textPath href="#cringClose" startOffset="12.07%" text-anchor="middle">SEAL OF TRUST</textPath></text>
                <text class="cdia"><textPath href="#cringClose" startOffset="32.43%" text-anchor="middle">&#9670; &#9670; &#9670;</textPath></text>
                <text><textPath href="#cringClose" startOffset="62.07%" text-anchor="middle">EVIDENCE OF YOUR CLAIMS</textPath></text>
                <text class="cdia"><textPath href="#cringClose" startOffset="91.71%" text-anchor="middle">&#9670; &#9670; &#9670;</textPath></text>
              </svg>
              <i><b><img class="cfp" src="/assets/fingerprint.webp" alt=""></b></i>
            </div>
            <div class="chnd on"><span class="chd">careerpassport.ai</span><span class="chh">your-handle</span></div>
            
            <div class="cchip">
              <svg viewBox="0 0 83 30" preserveAspectRatio="none" aria-hidden="true"><rect x="0" y="0" width="2" height="30"/><rect x="5" y="0" width="3" height="30"/><rect x="11" y="0" width="1" height="30"/><rect x="16" y="0" width="1" height="30"/><rect x="23" y="0" width="1" height="30"/><rect x="28" y="0" width="3" height="30"/><rect x="34" y="0" width="1" height="30"/><rect x="40" y="0" width="2" height="30"/><rect x="45" y="0" width="1" height="30"/><rect x="50" y="0" width="4" height="30"/><rect x="57" y="0" width="2" height="30"/><rect x="62" y="0" width="3" height="30"/><rect x="68" y="0" width="1" height="30"/><rect x="73" y="0" width="1" height="30"/><rect x="79" y="0" width="2" height="30"/></svg>
              <span>CP&middot;4417&middot;YN</span>
            </div>
          </div>
      </div>
      </div>
    </div>
  </div>
</section>
