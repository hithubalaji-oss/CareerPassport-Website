---
/**
 * The closing act - "Your candidates. Your relationships. Your business."
 * The email capture is a front-end state change only; no backend is wired.
 */
---

<section class="outro" id="outro">
  <div class="ocopy">
    <p class="eyebrow gold reveal"><i></i>The next recruitment business</p>
    <h2 class="reveal">Your candidates. Your relationships. <em class="serif">Your business.</em></h2>
    <p class="lede reveal">Whether you're an independent headhunter or a recruitment business, CareerPassport gives you more leverage from the network and relationships you have already built.</p>
    <div class="ctas reveal">
      <a class="btn" href="#outro">Book a Partner Demo</a>
      <a class="btn sec" href="#outro">Join CareerPassport</a>
    </div>
    <div class="wait reveal" data-capture>
      <input type="email" placeholder="you@agency.com" aria-label="Your work email">
      <button data-done="REQUEST SENT">BOOK A PARTNER DEMO</button>
    </div>
    <p class="brandline reveal">More leverage from all three.</p>
  </div>
  <div class="oart" aria-hidden="true">
    <div class="oring"></div>
    <div class="trace" style="position:relative;z-index:2;max-width:320px">
      <b>Network</b><em>&rarr;</em><b>Intelligence</b><em>&rarr;</em><b>Processing</b><em>&rarr;</em><b>Agents</b><em>&rarr;</em><b>Collaboration</b><em>&rarr;</em><b>Client</b>
    </div>
  </div>
</section>
