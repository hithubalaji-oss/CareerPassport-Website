                <circle class="gdot" cx="128" cy="150" r="4.5"/>
                </svg>
              </div>
            </article>
            <article class="stkc" data-i="1">
              <div class="stkbody">
                <i class="swi" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="2.5" y="7" width="19" height="13.5" rx="2.5"/><path d="M16 7V5.2A2.2 2.2 0 0 0 13.8 3h-3.6A2.2 2.2 0 0 0 8 5.2V7"/><path d="M2.5 12.5h19"/></svg></i>
                <b>Run your own client roles</b>
                <p>Manage your existing mandates privately using CareerPassport.</p>
                <a class="btn" href="#outro">Post a job<svg class="swar" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg></a>
              </div>
              <div class="stkimg" aria-hidden="true">
                <svg class="gly" viewBox="0 0 236 300">
                <path class="gs" pathLength="100" style="--d:0s" d="M30 96h64l20 26h88v134H30z"/>
                <path class="gs" pathLength="100" style="--d:.26s" d="M30 148h172"/>
                <g class="gsec">
                  <circle class="gs" pathLength="100" style="--d:.44s" cx="164" cy="216" r="38"/>
                  <circle class="gs" pathLength="100" style="--d:.54s" cx="164" cy="216" r="24"/>
                  <path class="gs" pathLength="100" style="--d:.64s" d="M164 240v34l-14-12M164 274l14-12"/>
                </g>
