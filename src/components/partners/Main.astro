</section>

<section class="scr stkband" id="s5" data-screen-label="05" data-keystop>
  <div class="stkpin">
    <div class="scin">
      <div class="scopy">
        <h2 class="reveal">More demand to work on. <em class="serif">More ways to fulfil.</em></h2>
        <p class="lede reveal">CareerPassport connects recruitment partners to a curated network of companies and recruitment businesses.</p>
        <p class="hline reveal">A curated network for you</p>
      </div>
      <div class="sart">
        <div class="stk" id="stk">
            <article class="stkc" data-i="0">
              <div class="stkbody">
                <i class="swi" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/></svg></i>
                <b>Work on new opportunities</b>
                <p>Access relevant roles posted by companies and recruitment partners across the sectors you want to work in.</p>
                <a class="btn" href="#outro">Show interest<svg class="swar" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg></a>
              </div>
              <div class="stkimg" aria-hidden="true">
                <svg class="gly" viewBox="0 0 236 300">
                <g class="gsec">
                  <path class="gs" pathLength="100" style="--d:0s" d="M38 60h68v68H38z"/>
                  <path class="gs" pathLength="100" style="--d:.06s" d="M122 60h68v68h-68z"/>
                  <path class="gs" pathLength="100" style="--d:.12s" d="M38 144h68v68H38z"/>
