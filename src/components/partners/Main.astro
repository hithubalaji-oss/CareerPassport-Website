---
/**
 * The page body, rebuilt in the 8 Sep pass. The old six pinned folds over one persistent
 * network panel are gone; it is now hero, a slab, the long `story` section, a stacked
 * band, and a quote slab — ordinary blocks, matching the direction For Companies moved to.
 *
 * It still loads `cp-shared.css` and `cp-page.js` for the shared fold engine and reveal
 * behaviour, with its own inline driver on top.
 */
---

<main>

<!-- ============ 01 · HERO ============ -->
<section class="hero" data-screen-label="01" data-keystop>
  <div class="hmesh" aria-hidden="true"></div>
  <div class="hgrain" aria-hidden="true"></div>
  <div class="hcopy">
    <h1 class="hbig">Fastest way to grow your recruitment business</h1>
    <p class="lede">Whether you are a solopreneur, headhunter or a recruitment agency, CareerPassport helps you get more from the candidates, clients and relationships you already have.</p>
    <div class="ctas">
      <a class="btn gh" href="#outro">Book a demo</a>
      <a class="btn" href="#outro">Sign up as a partner</a>
    </div>
  </div>

  <div class="strip" aria-label="Recruitment partners on CareerPassport">
    <div class="track" id="logoTrack"></div>
  </div>
</section>

<section class="slab" id="slab1" data-screen-label="02" data-keystop>
  <div class="slabin">
    <p class="eyebrow gold reveal"><i></i>The partner problem</p>
    <h2 class="slabh reveal">Most recruitment businesses already own the thing they are short of.</h2>
    <div class="stats">
      <div class="stat reveal" style="--i:0">
        <span class="statv" data-to="70">0<em>%</em></span>
        <b>of a partner database is never searched again</b><i>after the first placement</i>
      </div>
      <div class="stat reveal" style="--i:1">
        <span class="statv" data-to="3.4">0<em>x</em></span>
        <b>more roles worked per consultant</b><i>when the pipeline runs itself</i>
      </div>
      <div class="stat reveal" style="--i:2">
        <span class="statv" data-to="48">0<em>hrs</em></span>
        <b>saved on outreach and scheduling</b><i>in an average week</i>
      </div>
    </div>
  </div>
</section>

<section class="story" id="story" data-screen-label="03" data-keystop>
  <div class="storypin">
    <div class="storyin">
      <div class="storyacts">
        <div class="storyact on" data-i="0" style="--o:0">
          <div class="scopy">
      <p class="eyebrow gold"><i></i>01 / Your data</p>
      <h2>Make your scattered database <em class="serif">searchable</em></h2>
      <p class="lede">Turn the candidate network you already own into a living, queryable business asset.</p>
      <p class="hline">Scattered data &rarr; private talent intelligence.</p>
      <p class="fine">Your personal candidate database always stays private.</p>
          </div>
        </div>
        <div class="storyact" data-i="1" style="--o:1">
          <div class="scopy">
      <p class="eyebrow gold"><i></i>02 / Your operating system</p>
      <h2>Process applicants. <em class="serif">Don't just track them.</em></h2>
      <p class="lede">Move beyond recording recruitment activity. Structure the role, process candidates and keep the work moving.</p>
      <p class="hline">One place to manage your roles, candidates and hiring activity.</p>
          </div>
        </div>
        <div class="storyact" data-i="2" style="--o:2">
          <div class="scopy">
      <p class="eyebrow gold"><i></i>03 / Your AI workforce</p>
      <h2>Let technology handle the <em class="serif">repetitive motion.</em></h2>
      <p class="lede">Design agentic workflows across the pipeline from outreach to evaluation to shortlisting criteria to scheduling.</p>
      <p class="hline">Customise agents for execution and keep humans for judgement and relationships.</p>
          </div>
        </div>
        <div class="storyact" data-i="3" style="--o:3">
          <div class="scopy">
      <p class="eyebrow gold"><i></i>04 / Partner network</p>
      <h2>Grow together. With the terms <em class="serif">clear from the start.</em></h2>
      <p class="lede">Recruitment partnerships work when everyone knows what has been agreed. CareerPassport brings the commercial details into the same workflow.</p>
      <ul class="plain">
        <li>No guessing who owns what</li>
        <li>No ambiguity on commercials</li>
        <li>Clear visibility on where your payout stands</li>
      </ul>
          </div>
        </div>
      </div>
      <div class="stage2">
        <div class="stg on" data-i="0" style="--o:0">
          <div class="dia" id="dia2">
        <div class="dnodes">
          <span class="dnode" style="--d:0.00s"><svg class="fi" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2c-4.4 0-7.6 1.2-7.6 2.9S7.6 8 12 8s7.6-1.2 7.6-2.9S16.4 2.2 12 2.2Z"/><path d="M4.4 8.2v3.1c0 1.7 3.2 2.9 7.6 2.9s7.6-1.2 7.6-2.9V8.2c-1.6 1.2-4.4 1.8-7.6 1.8s-6-.6-7.6-1.8Z"/><path d="M4.4 14.5v3.1c0 1.7 3.2 2.9 7.6 2.9s7.6-1.2 7.6-2.9v-3.1c-1.6 1.2-4.4 1.8-7.6 1.8s-6-.6-7.6-1.8Z"/></svg><b>ATS</b></span>
          <span class="dnode" style="--d:0.06s"><svg class="fi" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 3h16a1 1 0 0 1 1 1v3.6H3V4a1 1 0 0 1 1-1Z"/><path d="M3 9.2h6.2v5.6H3V9.2Zm7.8 0H21v5.6H10.8V9.2ZM3 16.4h6.2V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-3.6Zm7.8 0H21V20a1 1 0 0 1-1 1h-8.2a1 1 0 0 1-1-1v-3.6Z"/></svg><b>Excel</b></span>
          <span class="dnode" style="--d:0.12s"><svg class="fi" viewBox="0 0 24 24" aria-hidden="true"><path d="M2.4 7.3 12 13.4l9.6-6.1A2 2 0 0 0 19.7 5H4.3a2 2 0 0 0-1.9 2.3Z"/><path d="M12 15.3 2.2 9.1V17a2 2 0 0 0 2 2h15.6a2 2 0 0 0 2-2V9.1L12 15.3Z"/></svg><b>Email</b></span>
          <span class="dnode" style="--d:0.18s"><svg class="fi" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.6c-5.2 0-9.4 3.7-9.4 8.3 0 2.5 1.2 4.7 3.2 6.2l-.9 4.1a.5.5 0 0 0 .74.55l4.06-2.36c.75.14 1.53.21 2.34.21 5.2 0 9.4-3.7 9.4-8.7S17.2 2.6 12 2.6Z"/></svg><b>WhatsApp</b></span>
          <span class="dnode" style="--d:0.24s"><svg class="fi" viewBox="0 0 24 24" aria-hidden="true"><path d="M13.6 2H6.4A2.4 2.4 0 0 0 4 4.4v15.2A2.4 2.4 0 0 0 6.4 22h11.2a2.4 2.4 0 0 0 2.4-2.4V8.4h-5.2a1.2 1.2 0 0 1-1.2-1.2V2Z"/><path d="M15.2 2.4V6.8h4.4L15.2 2.4Z"/></svg><b>Notes</b></span>
          <span class="dnode" style="--d:0.30s"><svg class="fi" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.2 6.6A2.4 2.4 0 0 1 5.6 4.2h3.6a2 2 0 0 1 1.62.82l1.1 1.5h6.48a2.4 2.4 0 0 1 2.4 2.4v9.06a2.4 2.4 0 0 1-2.4 2.4H5.6a2.4 2.4 0 0 1-2.4-2.4V6.6Z"/></svg><b>Files</b></span>
        </div>
        <svg class="dwire" viewBox="0 0 300 60" preserveAspectRatio="none" aria-hidden="true">
          <path class="fw" id="rpw0" d="M25 0C25 32 25 30 150 60"/>
          <path class="fw" id="rpw1" d="M75 0C75 30 88 32 150 60"/>
          <path class="fw" id="rpw2" d="M125 0C125 30 132 34 150 60"/>
          <path class="fw" id="rpw3" d="M175 0C175 30 168 34 150 60"/>
          <path class="fw" id="rpw4" d="M225 0C225 30 212 32 150 60"/>
          <path class="fw" id="rpw5" d="M275 0C275 32 275 30 150 60"/>
          <g class="fdots">
          <g class="fdotw"><animateMotion dur="5.4s" begin="0.00s" repeatCount="indefinite" calcMode="linear" keyPoints="0;1;1" keyTimes="0;0.35;1"><mpath href="#rpw0"/></animateMotion><circle class="fdot" r="1.37"><animate attributeName="opacity" dur="5.4s" begin="0.00s" repeatCount="indefinite" calcMode="linear" values="1;1;0;0" keyTimes="0;0.35;0.38;1"/></circle></g>
          <g class="fdotw"><animateMotion dur="5.4s" begin="0.10s" repeatCount="indefinite" calcMode="linear" keyPoints="0;1;1" keyTimes="0;0.35;1"><mpath href="#rpw1"/></animateMotion><circle class="fdot" r="1.37"><animate attributeName="opacity" dur="5.4s" begin="0.10s" repeatCount="indefinite" calcMode="linear" values="1;1;0;0" keyTimes="0;0.35;0.38;1"/></circle></g>
          <g class="fdotw"><animateMotion dur="5.4s" begin="0.20s" repeatCount="indefinite" calcMode="linear" keyPoints="0;1;1" keyTimes="0;0.35;1"><mpath href="#rpw2"/></animateMotion><circle class="fdot" r="1.37"><animate attributeName="opacity" dur="5.4s" begin="0.20s" repeatCount="indefinite" calcMode="linear" values="1;1;0;0" keyTimes="0;0.35;0.38;1"/></circle></g>
          <g class="fdotw"><animateMotion dur="5.4s" begin="0.30s" repeatCount="indefinite" calcMode="linear" keyPoints="0;1;1" keyTimes="0;0.35;1"><mpath href="#rpw3"/></animateMotion><circle class="fdot" r="1.37"><animate attributeName="opacity" dur="5.4s" begin="0.30s" repeatCount="indefinite" calcMode="linear" values="1;1;0;0" keyTimes="0;0.35;0.38;1"/></circle></g>
          <g class="fdotw"><animateMotion dur="5.4s" begin="0.40s" repeatCount="indefinite" calcMode="linear" keyPoints="0;1;1" keyTimes="0;0.35;1"><mpath href="#rpw4"/></animateMotion><circle class="fdot" r="1.37"><animate attributeName="opacity" dur="5.4s" begin="0.40s" repeatCount="indefinite" calcMode="linear" values="1;1;0;0" keyTimes="0;0.35;0.38;1"/></circle></g>
          <g class="fdotw"><animateMotion dur="5.4s" begin="0.50s" repeatCount="indefinite" calcMode="linear" keyPoints="0;1;1" keyTimes="0;0.35;1"><mpath href="#rpw5"/></animateMotion><circle class="fdot" r="1.37"><animate attributeName="opacity" dur="5.4s" begin="0.50s" repeatCount="indefinite" calcMode="linear" values="1;1;0;0" keyTimes="0;0.35;0.38;1"/></circle></g>
          </g>
        </svg>
        <div class="dhub" style="--d:.72s">
          <div class="dhubbar">
            <span class="dhubname"><i class="dhubm" aria-hidden="true"></i>CareerPassport</span>
            <span class="dhubtag">YOUR TALENT NETWORK</span>
          </div>
          <div class="dhome">
            <p class="dgreet">Who are you looking for?</p>
            <span class="dask">
              <svg class="fi" viewBox="0 0 24 24" aria-hidden="true"><path d="M10.6 2.4a8.2 8.2 0 0 1 6.44 13.3l4.3 4.3a1.2 1.2 0 0 1-1.7 1.7l-4.3-4.3A8.2 8.2 0 1 1 10.6 2.4Zm0 2.4a5.8 5.8 0 1 0 0 11.6 5.8 5.8 0 0 0 0-11.6Z"/></svg>
