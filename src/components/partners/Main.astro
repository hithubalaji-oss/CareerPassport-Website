            <span class="wfmerge" style="--ga:2 / 3"><i><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5.4" cy="5.6" r="2.3"/><circle cx="5.4" cy="18.4" r="2.3"/><circle cx="18.6" cy="12" r="2.3"/><path d="M7.7 6.6c3.4 1 4.4 3.2 8.6 5M7.7 17.4c3.4-1 4.4-3.2 8.6-5"/></svg></i><b>Merge</b><em>APPEND</em></span>
            <span class="wfnode" style="--ga:2 / 4"><i><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.4 14.6 9l6 .9-4.4 4.2 1.1 6-5.3-2.9-5.3 2.9 1.1-6L3.4 9.9l6-.9L12 3.4Z"/></svg></i><b>Evaluate replies</b><em>SCORE</em></span>
