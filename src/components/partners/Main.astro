            </span>
            <span class="dstat" style="--d:0.45s">
              <u>2</u><b>Offer</b>
            </span>
        </div>
        <div class="dtbl">
          <span class="dhead"><b>Candidate</b><em>Stage</em><u>Evidence</u><s>Last</s></span>
          <span class="drow" style="--d:0.62s">
            <b>Priya Raghavan</b><i>Enterprise sales</i>
            <em class="ptag">Evaluation</em>
            <u>3 / 4</u><s>2h</s>
          </span>
          <span class="drow" style="--d:0.69s">
            <b>Ashraf Kalam</b><i>Payments platform</i>
            <em class="ptag on">Offer</em>
            <u>4 / 4</u><s>1d</s>
          </span>
          <span class="drow" style="--d:0.76s">
            <b>Ravi Kumar</b><i>B2B SaaS</i>
            <em class="ptag">Screening</em>
            <u>1 / 4</u><s>3d</s>
          </span>
          <span class="drow" style="--d:0.83s">
            <b>Meera Sundaram</b><i>Platform sales</i>
            <em class="ptag">Screening</em>
            <u>2 / 4</u><s>4d</s>
          </span>
          <span class="drow" style="--d:0.90s">
            <b>Nikhil Barot</b><i>Solutions consulting</i>
            <em class="ptag">Sourced</em>
            <u>0 / 4</u><s>6d</s>
          </span>
          <span class="drow" style="--d:0.97s">
            <b>Sanjana Bhatt</b><i>Mid-market sales</i>
            <em class="ptag">Screening</em>
            <u>1 / 4</u><s>7d</s>
          </span>
          <span class="drow" style="--d:1.04s">
            <b>Tarun Menezes</b><i>Partnerships</i>
