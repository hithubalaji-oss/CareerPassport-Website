            </span>
            <div class="dsugs">
              <span class="dsug">Enterprise sales, 8+ years</span>
              <span class="dsug">Placed before, open to move</span>
              <span class="dsug">Spoke in the last 6 months</span>
            </div>
          </div>
        </div>
      </div>
        </div>
        <div class="stg" data-i="1" style="--o:1">
          <div class="dia dash" id="dia3">
        <div class="dbar">
          <span class="dbl"><i class="dbdot" aria-hidden="true"></i>CareerPassport</span>
          <span class="dbr">LIVE ROLE</span>
        </div>
        <div class="dstats">
            <span class="dstat" style="--d:0.24s">
              <u>46</u><b>Sourced</b>
            </span>
            <span class="dstat" style="--d:0.31s">
              <u>19</u><b>Screening</b>
            </span>
            <span class="dstat live" style="--d:0.38s">
