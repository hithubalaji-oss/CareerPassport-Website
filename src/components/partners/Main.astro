            <u>0 / 4</u><s>9d</s>
          </span>
        </div>
      </div>
        </div>
        <div class="stg" data-i="2" style="--o:2">
          <div class="dia" id="dia4">
        <div class="wfcanvas">
          <svg class="wfwire" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            <path class="wp" id="wfw0" d="M10 50H20Q24 50 24 17H30"/>
            <path class="wp" id="wfw1" d="M10 50H20Q24 50 24 83H30"/>
            <path class="wp" id="wfw2" d="M30 17H44Q48 17 48 50H50"/>
