---
/**
 * 01 - Hero. "Build your recruitment business in the AI era."
 */
---

<section class="hero" data-screen-label="01">
  <div class="bloom" aria-hidden="true"></div>
  <div class="hcopy">
    <p class="eyebrow gold"><i></i>For recruitment partners</p>
    <h1>Build your recruitment business in the <span class="serif">AI era.</span></h1>
    <p class="lede">Your candidates, your relationships, your expertise. <b>Made searchable, active and worth more.</b></p>
    <div class="ctas">
      <a class="btn" href="#outro">Book a partner demo</a>
      <a class="btn sec" href="#outro">Join CareerPassport</a>
    </div>
    <p class="pmono">YOUR CANDIDATES STAY PRIVATE &middot; YOU DECIDE WHEN TO COLLABORATE</p>
  </div>
  <div class="hart">
    <div class="present">
      <span class="pglow" aria-hidden="true"></span>
      <div class="pgroup">
      <div class="pscreen">
        <image-slot id="rp-hero-product" shape="rect" radius="14"
          placeholder="Drop a product screen grab (16:9)"></image-slot>
        <span class="pchrome" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="plbl">PRODUCT &middot; LIVE MANDATE</span>
      </div>
      <div class="pphone">
        <image-slot id="rp-hero-mobile" shape="rect" radius="18"
          placeholder="Drop the mobile UI (9:16)"></image-slot>
        <span class="pnotch" aria-hidden="true"></span>
      </div>
      </div>
    </div>
  </div>
</section>
