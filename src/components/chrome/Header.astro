---
/**
 * Sticky header — brand lockup, the two interior pages, and the sign-up / demo pair, with
 * a burger below the mobile breakpoint that opens the same links plus the same two CTAs.
 *
 * Redesigned in the 8 Sep pass: the nav no longer carries a "home" link (the brand lockup
 * is the way back), and gains `.hend` / `.hsep` / `.hcta`. Its styling now lives in the
 * shared `cp-header.css` rather than each page's own block, so the three pages cannot
 * disagree about their chrome.
 *
 * The mark is now the supplied logo lockup — icon and wordmark in one image
 * (`public/assets/careerpassport-logo.webp`, lossless alpha WebP off `assets/Careerpassport.png`,
 * 444x186). It replaces the passport chip AND the typeset wordmark, which were a stand-in for
 * exactly this. Height is what carries over: 27px, the chip's, on both viewports; width follows
 * the image's own 2.387:1. The alt text is the wordmark the image contains, so the link still
 * announces itself; nothing else in the header moved.
 *
 * The footer is deliberately untouched — its giant stacked CAREER / PASSPORT is live SVG text
 * with a light that walks the letterforms, which a raster cannot do.
 */
import { NAV_LINKS, isCurrent } from './nav-links';

const pathname = Astro.url.pathname;

/* The drawer's own list: home, then the two interior pages. Derived from NAV_LINKS rather
   than written out, so a route added there reaches the drawer too. */
const DRAWER_LINKS = [{ href: '/', label: 'Home' }, ...NAV_LINKS];
---

<header class="hdr">
  <a class="brand" href="/"><img src="/assets/careerpassport-logo.webp" width="444" height="186" alt="CareerPassport" decoding="async" fetchpriority="high"></a>
  <div class="hend">
    <nav class="nav">
      {NAV_LINKS.map(({ href, label }) => (
        <a class={isCurrent(href, pathname) ? 'here' : undefined} href={href}>{label}</a>
      ))}
    </nav>
    <span class="hsep" aria-hidden="true"></span>
    <div class="hcta">
      <a class="nbtn gh" href="#outro">Sign up</a>
      <a class="nbtn" href="#outro">Free demo</a>
    </div>
  </div>
  <button class="burger" id="burger" aria-label="Menu" aria-expanded="false"><i></i><i></i></button>
</header>

<nav class="mnav" id="mnav">
  {/* The drawer lists home as well as the two interior pages. In the bar the brand lockup is
      the way home and a "Home" link would be redundant beside it — but the drawer is a full
      screen given over to where you can go, and leaving the homepage off it reads as an
      omission rather than as restraint. `isCurrent` marks whichever page you are on. */}
  <div class="mlinks">
    {DRAWER_LINKS.map(({ href, label }) => (
      <a class={isCurrent(href, pathname) ? 'here' : undefined} href={href}>{label}</a>
    ))}
  </div>
  <div class="mfoot">
    {/* Sign up is the primary action here, so it takes the filled treatment and Free demo the
        ghost — the reverse of the bar, where the demo is the one being pushed. */}
    <div class="mcta">
      <a class="nbtn" href="#outro">Sign up</a>
      <a class="nbtn gh" href="#outro">Free demo</a>
    </div>
  </div>
</nav>

<script>
  /* The drawer is a full-screen sheet, so two things have to be true that did not matter
     when it was a 58px strip: Escape must close it, and the page behind it must not scroll
     under the reader's finger. Both live here rather than in each page's own driver —
     homepage.js, companies.js and cp-page.js each wire the burger's click separately, and
     three copies of this is how the three headers drifted apart in the first place.

     The class goes on <html> rather than a `position:fixed` body: fixing the body discards
     the scroll position, and the reader would be returned to the top of the page on close. */
  {
    const burgerEl = document.getElementById('burger');
    const sheet = document.getElementById('mnav');
    if (burgerEl && sheet) {
      const sync = () => document.documentElement.classList.toggle('mnav-open', sheet.classList.contains('open'));
      /* the page drivers own the toggle; this follows whatever they did to it */
      new MutationObserver(sync).observe(sheet, { attributes: true, attributeFilter: ['class'] });
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape' || !sheet.classList.contains('open')) return;
        sheet.classList.remove('open');
        burgerEl.setAttribute('aria-expanded', 'false');
        burgerEl.focus();
      });
    }
  }

  /* `--hdr` feeds hero padding, section scroll-margin and scroll-padding-top. Each page
     declares its own value (For Companies 83px, Partners 60px); the Homepage neither
     declares nor reads it.

     The failure worth guarding is a declared value SMALLER than the header really is —
     then headings slide under it on anchor jumps. So this only ever RAISES the value, and
     writes nothing at all when the page has not declared one. Staying silent leaves each
     page's own declaration to apply exactly as authored. */
  const hdr = document.querySelector<HTMLElement>('.hdr');
  if (hdr) {
    const root = document.documentElement;
    const declared = parseFloat(getComputedStyle(root).getPropertyValue('--hdr'));
    if (Number.isFinite(declared)) {
      const publish = () => {
        const measured = Math.ceil(hdr.getBoundingClientRect().height);
        if (measured > declared) root.style.setProperty('--hdr', `${measured}px`);
        else root.style.removeProperty('--hdr');
      };
      publish();
      new ResizeObserver(publish).observe(hdr);
    }
  }
</script>
