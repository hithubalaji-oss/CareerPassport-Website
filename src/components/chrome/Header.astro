---
/**
 * Sticky header — brand lockup, the two interior pages, and the sign-up / demo pair, with
 * a burger below the mobile breakpoint that opens the same links plus the same two CTAs.
 *
 * Redesigned in the 8 Sep pass: the nav no longer carries a "home" link (the brand lockup
 * is the way back), and gains `.hend` / `.hsep` / `.hcta`. Its styling now lives in the
 * shared `cp-header.css` rather than each page's own block, so the three pages cannot
 * disagree about their chrome.
 *
 * No logo file has ever been supplied. The mark is a passport chip plus the wordmark set
 * in type; supply an SVG and it replaces the chip here and in the footer.
 */
import { NAV_LINKS, isCurrent } from './nav-links';

const pathname = Astro.url.pathname;
---

<header class="hdr">
  <a class="brand" href="/"><i></i><span>CAREERPASSPORT</span></a>
  <div class="hend">
    <nav class="nav">
      {NAV_LINKS.map(({ href, label }) => (
        <a class={isCurrent(href, pathname) ? 'here' : undefined} href={href}>{label}</a>
      ))}
    </nav>
    <span class="hsep" aria-hidden="true"></span>
    <div class="hcta">
      <a class="nbtn gh" href="#outro">Sign up</a>
      <a class="nbtn" href="#outro">Free demo</a>
    </div>
  </div>
  <button class="burger" id="burger" aria-label="Menu" aria-expanded="false"><i></i><i></i></button>
</header>

<nav class="mnav" id="mnav">
  {NAV_LINKS.map(({ href, label }) => <a href={href}>{label}</a>)}
  <div class="mcta">
    <a class="nbtn gh" href="#outro">Sign up</a>
    <a class="nbtn" href="#outro">Free demo</a>
  </div>
</nav>

<script>
  /* `--hdr` feeds hero padding, section scroll-margin and scroll-padding-top. Each page
     declares its own value (For Companies 83px, Partners 60px); the Homepage neither
     declares nor reads it.

     The failure worth guarding is a declared value SMALLER than the header really is —
     then headings slide under it on anchor jumps. So this only ever RAISES the value, and
     writes nothing at all when the page has not declared one. Staying silent leaves each
     page's own declaration to apply exactly as authored. */
  const hdr = document.querySelector<HTMLElement>('.hdr');
  if (hdr) {
    const root = document.documentElement;
    const declared = parseFloat(getComputedStyle(root).getPropertyValue('--hdr'));
    if (Number.isFinite(declared)) {
      const publish = () => {
        const measured = Math.ceil(hdr.getBoundingClientRect().height);
        if (measured > declared) root.style.setProperty('--hdr', `${measured}px`);
        else root.style.removeProperty('--hdr');
      };
      publish();
      new ResizeObserver(publish).observe(hdr);
    }
  }
</script>
