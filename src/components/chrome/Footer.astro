---
/**
 * Footer — one compact row, so the closing fold and the footer land in the same viewport.
 * Brand lockup, the three pages side by side with hairline dividers, four social buttons,
 * and the giant CAREERPASSPORT wordmark beneath.
 *
 * The wordmark is drawn twice over the same baseline: `.fmfill` carries the top-down
 * opacity gradient (`#fmg`), and `.fmlit` strokes the edge only with `#fmedge`, whose own
 * window slides across on an 11s loop so the light walks a few letters at a time rather
 * than lighting the whole word. The stylesheet hides `.fmlit` under
 * `prefers-reduced-motion`. Both ids are referenced from CSS, so they stay literal rather
 * than being made unique per instance — there is only ever one footer per page.
 *
 * `textLength="994"` against the 1000-unit viewBox makes the wordmark span the measure at
 * any width. The seat into the page is a vertical fade on `.fmark`; the earlier horizontal
 * mask is gone, because that was what clipped the leading C and trailing T.
 *
 * Verified identical across both pages, so this stays one shared component.
 */
import { NAV_LINKS } from './nav-links';

const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="ftop">
    <a class="brand" href="/"><i></i><span>careerpassport.ai</span></a>
    <nav class="fnav">{NAV_LINKS.map(({ href, label }) => <a href={href}>{label}</a>)}</nav>
    <div class="fright">
      <div class="fsoc">
        <a href="#" aria-label="LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 9v9M6.5 5.6v.1M11 18v-5a3 3 0 0 1 6 0v5"/></svg></a>
        <a href="#" aria-label="X"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg></a>
        <a href="#" aria-label="GitHub"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 19c-4 1.2-4-2.2-5.5-2.8M15 21v-3.2a2.9 2.9 0 0 0-.8-2.2c2.7-.3 4.5-1.4 4.5-5a4 4 0 0 0-1.1-2.7 3.7 3.7 0 0 0-.1-2.8s-1.2-.3-3.7 1.4a9.3 9.3 0 0 0-5 0C6.3 3.8 5.1 4.1 5.1 4.1a3.7 3.7 0 0 0-.1 2.8A4 4 0 0 0 3.9 9.6c0 3.6 1.8 4.7 4.5 5A2.9 2.9 0 0 0 7.6 17V21"/></svg></a>
        <a href="#" aria-label="Email"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 6.5h17v11h-17zM3.5 7l8.5 6 8.5-6"/></svg></a>
      </div>
    </div>
  </div>
  <svg class="fmark" viewBox="0 0 1000 112" preserveAspectRatio="xMidYMax meet" aria-hidden="true">
    <defs>
      <linearGradient id="fmg" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="var(--ink)" stop-opacity=".14"/>
        <stop offset=".55" stop-color="var(--ink)" stop-opacity=".053"/>
        <stop offset="1" stop-color="var(--ink)" stop-opacity=".014"/>
      </linearGradient>
      <!-- the light that walks the letterforms: the gradient's own window slides across,
           so the edge lights up a few letters at a time rather than all at once -->
      <linearGradient id="fmedge" gradientUnits="objectBoundingBox" x1="-.3" y1="0" x2="0" y2="0">
        <stop offset="0" stop-color="var(--emerald)" stop-opacity="0"/>
        <stop offset=".5" stop-color="var(--mint,#e9d6aa)" stop-opacity=".135"/>
        <stop offset="1" stop-color="var(--emerald)" stop-opacity="0"/>
        <animate attributeName="x1" values="-.3;1" dur="11s" repeatCount="indefinite"/>
        <animate attributeName="x2" values="0;1.3" dur="11s" repeatCount="indefinite"/>
      </linearGradient>
    </defs>
    <text class="fmfill" x="500" y="104" text-anchor="middle" textLength="994"
      lengthAdjust="spacingAndGlyphs" font-size="130" font-weight="900"
      letter-spacing="-4">CAREERPASSPORT</text>
    <text class="fmlit" x="500" y="104" text-anchor="middle" textLength="994"
      lengthAdjust="spacingAndGlyphs" font-size="130" font-weight="900"
      letter-spacing="-4">CAREERPASSPORT</text>
  </svg>
  <p class="fcr">&copy; {year} CareerPassport Technologies Inc.</p>
</footer>
