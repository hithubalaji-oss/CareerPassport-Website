---
/**
 * Footer — a per-page call to action with the download / demo pair and the social row, the
 * four site links beside it, and the giant stacked wordmark beneath.
 *
 * Redesigned in the 8 Sep pass. The call-to-action line is the only part that differs
 * between pages, so it is a prop: "Your passport, waiting" / "Hire on evidence" / "Grow
 * your recruitment business". Everything else is identical across all three, verified.
 *
 * The wordmark is now two stacked lines. Both are forced to the same measure so the block
 * reads as one justified lockup, and each is drawn twice: `.fmfill` carries the top-down
 * opacity gradient (`#fmg`), `.fmlit` strokes the edge with `#fmedge`, whose window slides
 * across on an 11s loop so light walks a few letters at a time. Both gradient ids are
 * referenced from CSS, so they stay literal — there is only ever one footer per page.
 */
import { FOOTER_LINKS, isCurrent } from './nav-links';

interface Props {
  /** The call-to-action line above the buttons. Differs per page. */
  cta: string;
}

const { cta } = Astro.props;
const pathname = Astro.url.pathname;
const year = new Date().getFullYear();
---

<footer class="ftr" data-keystop>
  <div class="ftop">
    <div class="fcta">
      <p class="fctal">{cta}</p>
      <div class="fbtns">
        <a class="fbtn" href="#outro">Sign up</a>
        <a class="fbtn gh" href="#outro">Free demo</a>
      </div>
      <div class="fsoc">
              <a href="#" aria-label="LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.36V9h3.42v1.56h.05a3.75 3.75 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56ZM22.22 0H1.77C.8 0 0 .78 0 1.75v20.5C0 23.22.8 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.75V1.75C24 .78 23.2 0 22.22 0Z"/></svg></a>
              <a href="#" aria-label="Twitter"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.46l8.6-9.83L0 1.15h7.59l5.44 7.2Zm-1.29 19.49h2.04L6.49 3.24H4.3Z"/></svg></a>
              <a href="#" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C8.74 0 8.33.02 7.05.07 5.78.13 4.9.33 4.14.63a5.6 5.6 0 0 0-2.02 1.32A5.6 5.6 0 0 0 .8 3.97c-.3.76-.5 1.64-.56 2.91C.19 8.16.17 8.57.17 12s.02 3.84.07 5.12c.06 1.27.26 2.15.56 2.91a5.6 5.6 0 0 0 1.32 2.02 5.6 5.6 0 0 0 2.02 1.32c.76.3 1.64.5 2.91.56 1.28.05 1.69.07 5.12.07s3.84-.02 5.12-.07c1.27-.06 2.15-.26 2.91-.56a5.6 5.6 0 0 0 2.02-1.32 5.6 5.6 0 0 0 1.32-2.02c.3-.76.5-1.64.56-2.91.05-1.28.07-1.69.07-5.12s-.02-3.84-.07-5.12c-.06-1.27-.26-2.15-.56-2.91a5.6 5.6 0 0 0-1.32-2.02A5.6 5.6 0 0 0 20.03.63c-.76-.3-1.64-.5-2.91-.56C15.84.02 15.43 0 12 0Zm0 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23a3.7 3.7 0 0 1-.9 1.38 3.7 3.7 0 0 1-1.38.9c-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16Zm0 3.68a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32Zm0 10.16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm7.85-10.4a1.44 1.44 0 1 1-2.88 0 1.44 1.44 0 0 1 2.88 0Z"/></svg></a>
              <a href="#" aria-label="YouTube"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19C0 8.08 0 12 0 12s0 3.92.5 5.81a3.02 3.02 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14C24 15.92 24 12 24 12s0-3.92-.5-5.81ZM9.55 15.57V8.43L15.82 12Z"/></svg></a>
            </div>
    </div>
    <nav class="fnav">
      {FOOTER_LINKS.map(({ href, label }) => (
        <a class={isCurrent(href, pathname) ? 'here' : undefined} href={href}>{label}</a>
      ))}
    </nav>
  </div>
  <svg class="fmark" viewBox="0 0 1000 322" preserveAspectRatio="xMidYMax meet" aria-hidden="true">
    <defs>
      <linearGradient id="fmg" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="var(--ink)" stop-opacity=".14"/>
        <stop offset=".55" stop-color="var(--ink)" stop-opacity=".053"/>
        <stop offset="1" stop-color="var(--ink)" stop-opacity=".014"/>
      </linearGradient>
      <!-- the light that walks the letterforms: the gradient's own window slides across,
           so the edge lights up a few letters at a time rather than all at once -->
      <linearGradient id="fmedge" gradientUnits="objectBoundingBox" x1="-.3" y1="0" x2="0" y2="0">
        <stop offset="0" stop-color="var(--emerald)" stop-opacity="0"/>
        <stop offset=".5" stop-color="var(--mint,#e9d6aa)" stop-opacity=".135"/>
        <stop offset="1" stop-color="var(--emerald)" stop-opacity="0"/>
        <animate attributeName="x1" values="-.3;1" dur="11s" repeatCount="indefinite"/>
        <animate attributeName="x2" values="0;1.3" dur="11s" repeatCount="indefinite"/>
      </linearGradient>
    </defs>
    <!-- Stacked as two lines. Both are forced to the same measure so the block reads as
         one justified lockup; CAREER is the shorter word, so it takes the wider tracking
         and the glyph shapes are left alone (lengthAdjust="spacing", not spacingAndGlyphs,
         which would have stretched the six letters 33% fatter than the eight below). -->
    <text class="fmfill" x="500" y="146" text-anchor="middle" font-size="182" font-weight="900">CAREER</text>
    <text class="fmlit" x="500" y="146" text-anchor="middle" font-size="182" font-weight="900">CAREER</text>
    <text class="fmfill" x="500" y="304" text-anchor="middle" font-size="182" font-weight="900">PASSPORT</text>
    <text class="fmlit" x="500" y="304" text-anchor="middle" font-size="182" font-weight="900">PASSPORT</text>
  </svg>
  <p class="fcr">&copy; {year} CareerPassport Technologies Inc</p>
</footer>
