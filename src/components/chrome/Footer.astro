---
/**
 * Footer — brand lockup, four social icon buttons, and the giant CAREERPASSPORT wordmark
 * as SVG text under a top-down opacity gradient (.14 -> .03 -> 0).
 *
 * `textLength="1000"` against the 1000-unit viewBox makes the wordmark span the measure
 * exactly at any width, so it never falls short of or overruns the gutters.
 *
 * The gradient keeps the literal id `fmg`: the fill is applied from CSS
 * (`.fmark text{fill:url(#fmg)}`), not from the markup, so the id is part of that
 * contract and must not be made unique per instance.
 */
import { NAV_LINKS } from './nav-links';

const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="ftop">
    <a class="brand" href="/"><i></i><span>careerpassport.ai</span></a>
    <div class="fright">
      <div class="fsoc">
        <a href="#" aria-label="LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 9v9M6.5 5.6v.1M11 18v-5a3 3 0 0 1 6 0v5"/></svg></a>
        <a href="#" aria-label="X"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg></a>
        <a href="#" aria-label="GitHub"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 19c-4 1.2-4-2.2-5.5-2.8M15 21v-3.2a2.9 2.9 0 0 0-.8-2.2c2.7-.3 4.5-1.4 4.5-5a4 4 0 0 0-1.1-2.7 3.7 3.7 0 0 0-.1-2.8s-1.2-.3-3.7 1.4a9.3 9.3 0 0 0-5 0C6.3 3.8 5.1 4.1 5.1 4.1a3.7 3.7 0 0 0-.1 2.8A4 4 0 0 0 3.9 9.6c0 3.6 1.8 4.7 4.5 5A2.9 2.9 0 0 0 7.6 17V21"/></svg></a>
        <a href="#" aria-label="Email"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 6.5h17v11h-17zM3.5 7l8.5 6 8.5-6"/></svg></a>
      </div>
      <nav class="fnav">{NAV_LINKS.map(({ href, label }) => <a href={href}>{label}</a>)}</nav>
    </div>
  </div>
  <svg class="fmark" viewBox="0 0 1000 96" preserveAspectRatio="xMidYMax meet" aria-hidden="true">
    <defs><linearGradient id="fmg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="var(--ink)" stop-opacity=".14"/>
      <stop offset=".62" stop-color="var(--ink)" stop-opacity=".03"/>
      <stop offset="1" stop-color="var(--ink)" stop-opacity="0"/>
    </linearGradient></defs>
    <text x="500" y="104" text-anchor="middle" textLength="1000" lengthAdjust="spacingAndGlyphs"
      font-size="130" font-weight="900" letter-spacing="-4">CAREERPASSPORT</text>
  </svg>
  <p class="fcr">&copy; {year} CareerPassport Technologies Inc.</p>
</footer>
