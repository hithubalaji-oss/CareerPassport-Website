---
/**
 * The closing act — the passport arrives in the glowing ring, over the waitlist capture.
 * Front-end state change only; no backend is wired.
 */
---

<section class="outro" id="outro" data-keystop>
  <div class="oart" aria-hidden="true">
    <div class="oring"></div>
    <div class="opad"></div>
    <div class="obook">
      <div class="ofloat"><div class="oslot" id="oslot"></div></div>
    </div>
  </div>
  <div class="ocopy">
    <h2 class="reveal">Let the experiences you've lived showcase <em class="serif">who you really are</em></h2>
    <p class="lede reveal">Evidence of what you can do. A clearer picture of who you're becoming. A professional identity ready for wherever you go next</p>
    <div class="wait reveal" id="wait">
      <input id="waitEmail" type="email" placeholder="you@work.com" aria-label="Your email">
      <button id="waitBtn">JOIN THE WAITLIST</button>
    </div>
    <p class="reveal ofine">Be among the first professionals to build their CareerPassport</p>
  </div>
</section>
