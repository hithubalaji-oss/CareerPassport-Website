---
/**
 * The closing act - the passport arrives in the glowing ring, and the waitlist capture.
 *
 * The capture validates on click or Enter and swaps the button label. No backend is
 * wired: this is a front-end state change only.
 */
---

<section class="outro" id="outro">
  <div class="oart" aria-hidden="true">
    <div class="oring"></div>
    <div class="opad"></div>
    <div class="obook">
      <div class="ofloat"><div class="oslot" id="oslot"></div></div>
    </div>
  </div>
  <div class="ocopy">
    <p class="eyebrow gold reveal"><i></i>Your passport, issued</p>
    <h2 class="reveal">Let the experiences you've lived showcase <em class="serif">who you really are.</em></h2>
    <p class="lede reveal">CareerPassport gives those experiences somewhere to grow into something more — evidence of what you can do, a clearer understanding of who you're becoming, and a professional identity ready for wherever you choose to go next.</p>
    <div class="wait reveal" id="wait">
      <input id="waitEmail" type="email" placeholder="you@work.com" aria-label="Your email">
      <button id="waitBtn">JOIN THE WAITLIST</button>
    </div>
    <p class="reveal" style="font-size:15.5px;color:var(--meta)">Be among the first professionals to build their CareerPassport.</p>
    <p class="brandline reveal">Your career deserves more than a profile.</p>
  </div>
</section>
